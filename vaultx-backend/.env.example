# VaultX Backend — Environment Variables
# Copy this file to .env and fill in the values

SERVER_PORT=8080

# PostgreSQL
DB_URL=jdbc:postgresql://localhost:5432/vaultx
DB_USERNAME=vaultx
DB_PASSWORD=vaultx_1234

# JWT — Base64-encoded 256-bit key (min 32 bytes)
# Generate: openssl rand -base64 32
JWT_SECRET=dGhpcy1pcy1hLXZlcnktbG9uZy1hbmQtc2VjdXJlLWp3dC1zZWNyZXQta2V5LWZvci12YXVsdHg=
JWT_EXPIRATION=86400000
JWT_REFRESH_EXPIRATION=604800000

# CORS — comma-separated list of allowed frontend origins
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ======================
# Cloudflare R2 / MinIO Storage
# ======================
R2_ENDPOINT_URL=https://<your_account_id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your_r2_access_key
R2_SECRET_ACCESS_KEY=your_r2_secret_key
R2_BUCKET_NAME=vaultx-documents

# Frontend URL
FRONTEND_URL=http://localhost:5173

# Pingram Notifications API
PINGRAM_API_KEY=YOUR_PINGRAM_API_KEY
DB_URL=jdbc:postgresql://ep-autumn-rice-axmqscpa-pooler.c-4.us-east-2.aws.neon.tech/vaultx?sslmode=require
DB_USERNAME=neondb_owner
DB_PASSWORD=YOUR_PASSWORD