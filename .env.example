# VaultX — Root Environment Example
# Copy this file to .env and update the values

# ─────────────────────────────────────────────
# DATABASE
# ─────────────────────────────────────────────
POSTGRES_DB=vaultx
POSTGRES_USER=vaultx
POSTGRES_PASSWORD=1234

# ─────────────────────────────────────────────
# BACKEND
# ─────────────────────────────────────────────
SERVER_PORT=8080
DB_URL=jdbc:postgresql://postgres:5432/vaultx
DB_USERNAME=vaultx
DB_PASSWORD=vaultx_1234

# JWT — Generate a secure Base64-encoded 256-bit key:
# Linux/Mac: openssl rand -base64 32
# Windows:   [Convert]::ToBase64String([System.Security.Cryptography.RandomNumberGenerator]::GetBytes(32))
JWT_SECRET=dGhpcy1pcy1hLXZlcnktbG9uZy1hbmQtc2VjdXJlLWp3dC1zZWNyZXQta2V5LWZvci12YXVsdHg=
JWT_EXPIRATION=86400000
JWT_REFRESH_EXPIRATION=604800000

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# REDIS (Optional - Rate Limiting & CSRF Token Persistence)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# GOOGLE GEMINI AI (Optional - Intelligent Document Classification)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash

# PINGRAM / EMAIL SMS NOTIFICATION (Optional)
PINGRAM_API_KEY=your_pingram_api_key_here

# ─────────────────────────────────────────────
# FRONTEND
# ─────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8080
VITE_APP_NAME=VaultX

